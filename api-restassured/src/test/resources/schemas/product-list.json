{
  "type": "object",
  "required": ["status", "data"],
  "properties": {
    "status": { "type": "string" },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "price", "image"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "price": { "type": "number" },
          "image": { "type": "string" }
        }
      }
    }
  }
}
