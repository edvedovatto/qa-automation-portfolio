{
  "type": "object",
  "required": ["status", "data"],
  "properties": {
    "status": { "type": "string" },
    "data": {
      "type": "object",
      "required": ["id", "UserId", "Products"],
      "properties": {
        "id": { "type": "integer" },
        "UserId": { "type": "integer" },
        "Products": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "price", "BasketItem"],
            "properties": {
              "id": { "type": "integer" },
              "name": { "type": "string" },
              "price": { "type": "number" },
              "BasketItem": {
                "type": "object",
                "required": ["quantity"],
                "properties": {
                  "quantity": { "type": "integer" }
                }
              }
            }
          }
        }
      }
    }
  }
}
