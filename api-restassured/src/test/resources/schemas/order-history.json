{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": ["status", "data"],
  "properties": {
    "status": { "enum": ["success"] },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["orderId", "email", "totalPrice", "products", "delivered"],
        "properties": {
          "orderId": { "type": "string" },
          "email": { "type": "string" },
          "totalPrice": { "type": "number" },
          "delivered": { "type": "boolean" },
          "products": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "name", "price", "quantity", "total"],
              "properties": {
                "id": { "type": "integer" },
                "name": { "type": "string" },
                "price": { "type": "number" },
                "quantity": { "type": "integer", "minimum": 1 },
                "total": { "type": "number" }
              }
            }
          }
        }
      }
    }
  }
}
