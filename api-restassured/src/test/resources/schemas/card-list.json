{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": ["status", "data"],
  "properties": {
    "status": { "enum": ["success"] },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "UserId", "fullName", "cardNum", "expMonth", "expYear"],
        "properties": {
          "id": { "type": "integer" },
          "UserId": { "type": "integer" },
          "fullName": { "type": "string" },
          "cardNum": { "type": "string", "pattern": "^[*]{12}[0-9]{4}$" },
          "expMonth": { "type": "integer", "minimum": 1, "maximum": 12 },
          "expYear": { "type": "integer" }
        }
      }
    }
  }
}
