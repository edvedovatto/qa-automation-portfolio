{
  "name": "e2e-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "UI end-to-end tests for OWASP Juice Shop",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "bddgen && playwright test",
    "test:smoke": "bddgen && playwright test --grep @smoke",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "playwright-bdd": "9.2.1",
    "typescript": "^7.0.2"
  }
}
